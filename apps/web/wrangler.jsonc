/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Self-hosted OAuth callback relay. The full Next.js site can be built separately on Linux CI.
	"name": "orange-cloud-selfhost",
	"main": "oauth-relay.ts",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "o-c.wuuconix.link",
			"custom_domain": true
		}
	]
}
